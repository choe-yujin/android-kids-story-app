package com.timor.kidsstory.domain.usecase.book

import com.timor.kidsstory.domain.model.Book
import com.timor.kidsstory.domain.model.DownloadProgress
import com.timor.kidsstory.domain.model.DownloadStatus
import com.timor.kidsstory.domain.repository.BookRepository
import io.mockk.MockKAnnotations
import io.mockk.coEvery
import io.mockk.impl.annotations.MockK
import kotlinx.coroutines.test.runTest
import org.junit.Before
import org.junit.Test
import org.junit.Assert.*

/**
 * GetAllBooksUseCase 단위 테스트
 * 
 * Clean Architecture Phase 1에서 생성된 UseCase의 동작을 검증
 * - 로컬 책과 다운로드된 책의 병합 로직 테스트
 * - 중복 제거 로직 테스트
 * - 오류 처리 테스트
 */
class GetAllBooksUseCaseTest {

    @MockK
    private lateinit var bookRepository: BookRepository

    private lateinit var useCase: GetAllBooksUseCase

    @Before
    fun setup() {
        MockKAnnotations.init(this)
        useCase = GetAllBooksUseCase(bookRepository)
    }

    @Test
    fun `when repository returns success, useCase should return merged books`() = runTest {
        // Given
        val languageCode = "ko-kr"
        val localBooks = listOf(
            createMockBook("801_ko-kr", "로컬 책 1"),
            createMockBook("802_ko-kr", "로컬 책 2")
        )
        val downloadedBooks = listOf(
            createMockBook("803_ko-kr", "다운로드 책 1")
        )

        coEvery { bookRepository.getBooks(languageCode) } returns Result.success(localBooks)
        coEvery { bookRepository.getDownloadedBooks(languageCode) } returns Result.success(downloadedBooks)

        // When
        val result = useCase(languageCode)

        // Then
        assertTrue("UseCase should return success", result.isSuccess)
        val books = result.getOrNull()!!
        assertEquals("Should have 3 books total", 3, books.size)
        
        // 로컬 책들은 다운로드 상태가 true여야 함
        val localBooksInResult = books.take(2)
        localBooksInResult.forEach { book ->
            assertTrue("Local books should be downloaded", book.isDownloaded)
            assertEquals("Local books should have DOWNLOADED status", 
                DownloadStatus.DOWNLOADED, book.downloadProgress.status)
        }
    }

    @Test
    fun `when there are duplicate books, useCase should remove duplicates`() = runTest {
        // Given
        val languageCode = "en-ph"
        val localBooks = listOf(
            createMockBook("801_en-ph", "Local Book")
        )
        val downloadedBooks = listOf(
            createMockBook("801_en-ph", "Downloaded Book"), // 같은 책
            createMockBook("802_en-ph", "Unique Downloaded Book")
        )

        coEvery { bookRepository.getBooks(languageCode) } returns Result.success(localBooks)
        coEvery { bookRepository.getDownloadedBooks(languageCode) } returns Result.success(downloadedBooks)

        // When
        val result = useCase(languageCode)

        // Then
        assertTrue("UseCase should return success", result.isSuccess)
        val books = result.getOrNull()!!
        assertEquals("Should have 2 books (duplicate removed)", 2, books.size)
        
        // 첫 번째 책은 로컬 버전이어야 함 (우선순위)
        assertEquals("First book should be local version", "Local Book", books[0].title)
        assertEquals("Second book should be unique downloaded book", "Unique Downloaded Book", books[1].title)
    }

    @Test
    fun `when local books repository fails, useCase should return failure`() = runTest {
        // Given
        val languageCode = "tet"
        val exception = RuntimeException("Repository error")
        
        coEvery { bookRepository.getBooks(languageCode) } returns Result.failure(exception)

        // When
        val result = useCase(languageCode)

        // Then
        assertTrue("UseCase should return failure", result.isFailure)
        assertEquals("Should return same exception", exception, result.exceptionOrNull())
    }

    @Test
    fun `when downloaded books repository fails, useCase should continue with local books only`() = runTest {
        // Given
        val languageCode = "ko-kr"
        val localBooks = listOf(
            createMockBook("801_ko-kr", "로컬 책만")
        )
        val exception = RuntimeException("Downloaded books error")

        coEvery { bookRepository.getBooks(languageCode) } returns Result.success(localBooks)
        coEvery { bookRepository.getDownloadedBooks(languageCode) } returns Result.failure(exception)

        // When
        val result = useCase(languageCode)

        // Then
        assertTrue("UseCase should return success", result.isSuccess)
        val books = result.getOrNull()!!
        assertEquals("Should have only local books", 1, books.size)
        assertEquals("Should be the local book", "로컬 책만", books[0].title)
    }

    @Test
    fun `when both repositories return empty lists, useCase should return empty list`() = runTest {
        // Given
        val languageCode = "tetum"
        
        coEvery { bookRepository.getBooks(languageCode) } returns Result.success(emptyList())
        coEvery { bookRepository.getDownloadedBooks(languageCode) } returns Result.success(emptyList())

        // When
        val result = useCase(languageCode)

        // Then
        assertTrue("UseCase should return success", result.isSuccess)
        val books = result.getOrNull()!!
        assertTrue("Should return empty list", books.isEmpty())
    }

    /**
     * 테스트용 Mock Book 생성 헬퍼 함수
     */
    private fun createMockBook(storyId: String, title: String): Book {
        return Book(
            storyId = storyId,
            title = title,
            coverImage = "test_cover.jpg",
            level = 1,
            category = "test",
            pageCount = 10,
            contributors = emptyList(),
            sponsors = emptyList(),
            copyright = "test copyright",
            originalCopyright = null,
            pages = emptyList(),
            isDownloaded = false,
            downloadProgress = DownloadProgress(DownloadStatus.NOT_DOWNLOADED)
        )
    }
}